  filter(upos != "PUNCT") |>
  group_by(doc_id) |>
  summarise(material_per_1000 = sum(lemma %in% material_lexicon) / n() * 1000)

# 8b. robustness: stem-based (inflections, diminutives; proper nouns excluded)
stems <- c(
  "tierr", "barro", "lodo", "lodaz", "polvo", "polvar", "piedr", "roca", "arena", "suelo", "fango", "peña",
  "agua", "lluvi", "río", "nieb", "charc", "humed", "mar$",
  "raíz", "raice", "árbol", "hoja", "hierb", "bosqu", "mader", "tronc", "ramas?$", "flor", "zacat",
  "podrid", "podrir", "pudr", "ceniz", "gusan", "moho", "hongo", "carroñ", "polill"
)
bad     <- "^(agua(nt|rd|d))"
stem_rx <- str_c("^(", str_c(stems, collapse = "|"), ")")

stem_hits <- anno_all |>
  filter(upos != "PUNCT") |>
  mutate(lemma_l = str_to_lower(lemma),
         hit = str_detect(lemma_l, stem_rx) & !str_detect(lemma_l, bad) & upos != "PROPN")

dens_stem <- stem_hits |>
  group_by(doc_id) |>
  summarise(stem_per_1000 = sum(hit) / n() * 1000)

dens_compare <- left_join(dens_total, dens_stem, by = "doc_id")
as.data.frame(dens_compare)
cor(dens_compare$material_per_1000, dens_compare$stem_per_1000, method = "spearman")  # ~0.99
write_csv(dens_compare, "data/density_by_part.csv")

stem_hits |> filter(hit) |> count(lemma_l, sort = TRUE) |>
