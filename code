# ---- 8c. KWIC check: literal vs. figurative (window idea from Week 3) ----
# Step 1 (runs once): draw the sample; guarded so it never overwrites your coding.
focus_rx  <- "^(piedr|polv|ceniz|flor|raíz|raice|tierr|barro|lodo)"
kwic_file <- "data/kwic_to_code.xlsx"

if (!file.exists(kwic_file)) {
  kwic_base <- anno_all |>
    group_by(doc_id) |> mutate(pos = row_number()) |> ungroup()

  hits <- kwic_base |>
    filter(upos != "PUNCT", str_detect(str_to_lower(lemma), focus_rx),
           !str_detect(str_to_lower(lemma), "^tierracalent"))

  context_of <- function(d, p, w = 12) {
    x <- kwic_base |> filter(doc_id == d, pos >= p - w, pos <= p + w)
    str_c(x$token, collapse = " ")
  }

  set.seed(570)
  sample_hits <- hits |>
    mutate(author = str_sub(doc_id, 1, 3)) |>
    group_by(author) |>
    slice_sample(n = 10) |>
    ungroup() |>
    mutate(context = map2_chr(doc_id, pos, context_of),
           use = NA_character_,   # literal / figurative / body / na (= character name)
           note = NA_character_) |>
    select(doc_id, token, lemma, context, use, note)

  write_excel_csv(sample_hits, "data/kwic_to_code.csv")  # open in Excel, code `use`,
  # then save as data/kwic_to_code.xlsx
}

