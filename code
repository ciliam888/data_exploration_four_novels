top_n_terms <- function(mat, n = 12) {
  map_dfr(rownames(mat), \(d) {
    top <- sort(mat[d, ], decreasing = TRUE)[1:n]
    tibble(doc_id = d, term = names(top), tfidf = unname(top))
  })
}
tfidf_top_tbl      <- top_n_terms(tfidf_mat)
tfidf_top_with_tbl <- top_n_terms(tfidf_mat_with)

print_terms <- \(df) df |>
  group_by(doc_id) |>
  summarise(top_terms = str_c(term, collapse = ", ")) |>
  mutate(line = str_c(doc_id, ": ", top_terms)) |>
  pull(line) |> walk(cat, "\n")

