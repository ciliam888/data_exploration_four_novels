# ---- 1. Load and clean texts (Step 0) ----------
rd <- \(pat) {
  f <- list.files("texts", pattern = pat, full.names = TRUE)
  stopifnot(length(f) == 1)
  read_file(f, locale = locale(encoding = "UTF-8")) |>
    str_replace_all("\r\n", "\n")
}

bombal <- rd("Bombal")   # trimmed by hand to La amortajada

castel <- rd("Castellanos")
castel <- str_sub(castel, str_locate(castel, fixed("—…Y entonces, coléricos"))[1, "start"]) |>
  str_remove("(?s)Segunda Parte.*?Esto es lo que se recuerda de aquellos días:") |>
  str_remove("(?s)Tercera Parte.*?Anales de los xahil")

garro <- rd("Garro")
garro <- str_sub(garro, str_locate(garro, fixed("Aquí estoy, sentado sobre esta piedra aparente"))[1, "start"]) |>
  str_remove_all("(?m)^\\s*(PRIMERA|SEGUNDA) PARTE\\s*$") |>
  str_remove_all("(?m)^\\s*\\*( \\*)+\\s*$")

somers <- rd("Somers") |> str_remove_all("\\[\\d\\]")   # footnote markers

strip_roman <- \(x) str_remove_all(x, "(?m)^\\s*[IVXL]+\\s*$")   # chapter numerals
castel <- strip_roman(castel)
garro  <- strip_roman(garro)

txts <- list(BOM = bombal, CAS = castel, GAR = garro, SOM = somers)


# ---- 2. Corpus: 4 novels x 5 equal-token parts = 20 documents -
split_parts <- function(text, n = 5) {
  w <- str_split(str_squish(text), " ")[[1]]
  g <- cut(seq_along(w), n, labels = FALSE)
  map_chr(1:n, \(i) str_c(w[g == i], collapse = " "))
}

meta <- tribble(
  ~code, ~author,       ~book,
  "BOM", "Bombal",      "La amortajada",
  "CAS", "Castellanos", "Balún Canán",
  "GAR", "Garro",       "Los recuerdos del porvenir",
  "SOM", "Somers",      "La mujer desnuda"
)

corpus_tbl <- meta |>
  mutate(text = map(code, \(c) split_parts(txts[[c]])), part = list(1:5)) |>
  unnest(c(text, part)) |>
  mutate(doc_id        = str_c(code, part, sep = "_"),
         n_tokens      = str_count(text, "\\S+"),
         text_original = text,                                         # keep original (Week 3)
         text_clean    = str_replace_all(text_original, "\\s+", " "))  # collapse whitespace

corpus_tbl |> select(doc_id, author, part, n_tokens)

write_csv(corpus_tbl |> select(doc_id, author, book, part, n_tokens),
